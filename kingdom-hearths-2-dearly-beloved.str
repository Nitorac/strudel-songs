const debug = false;
setcpm(15);

// Debug purposes (easier to liste multiple times a music section in the middle of many loops)
const fastForward = (wantedCPM, cyclesToSkip, skipSpeed, offset = 1.25) => {
  if(cyclesToSkip <= 0) {
    setcpm(wantedCPM);
  }
  setcpm(wantedCPM * skipSpeed);
  setTimeout(() => setcpm(wantedCPM), (cyclesToSkip - offset) * 60000 / (wantedCPM * skipSpeed));
};

if(debug) {
  fastForward(
    cpm,
    24,
    18,
  );
}


const mScale = (x, octava = 3) => x.scale('Eb'.concat(octava, ':major'));

$: mScale(n("5, -18"), 5)
  .sound("gm_string_ensemble_1")
  .room(1.0)
  .gain(0.3);

$: mScale(n("5 2 1 -1 -2"), 3)
  .superimpose(x => x.transpose(12))
  .gain(.4)
  .room(1.0)
  .sound("gm_orchestral_harp");

_$: mScale(n("0 6 5"), 3)
  .room(1.0)
  .attack(0.7)
  .clip(1.05)
  .sound("gm_cello");

