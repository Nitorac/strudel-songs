@title Outer Wilds - Traveler's theme
@by Andrew Prahlow (strudelised by Nitorac)
@license CC BY-NC-SA
*/
const debug = false;
const cpm = 92/8;

setcpm(cpm);

// Debug purposes (easier to liste multiple times a music section in the middle of many loops)
const fastForward = (wantedCPM, cyclesToSkip, skipSpeed, offset = 1.25) => {
  if(cyclesToSkip <= 0) {
    setcpm(wantedCPM);
  }
  setcpm(wantedCPM * skipSpeed);
  setTimeout(() => setcpm(wantedCPM), (cyclesToSkip - offset) * 60000 / (wantedCPM * skipSpeed));
};

if(debug) {
  fastForward(
    cpm,
    24,
    18,
  );
}

const as = register('as', (mapping, pat) => { 
  mapping = Array.isArray(mapping) ? mapping : [mapping];
  return pat.fmap((v) => { 
    v = Array.isArray(v) ? v : [v, 0];
    return Object.fromEntries(mapping.map((prop, i) => [prop, v[i]]));
  });
});

const melody = n("<-4 -3 -2 -3> 0 2@1.5 0@0.5 [3 2] [1 0] [1 2] <0 [4 2]>");

const song = stack(
  // Banjo
  melody
    .sound("gm_banjo")
    .scale("G3:major")
    .clip(1.3)
    ._pianoroll(),
  // Whistle
  melody
    .scale("G5:major")
    .sound("gm_piccolo")
    .vib("7:0.15")
    .clip(1.1)
    .gain(.4)
    .mask("<0@12 1@116>")
    ._pianoroll()
,
  // Harmonica
  n("<[-12,-10,-7] [-10,-7,-5] [-7,-5,-3] [-5,-3,0] [0,2,4] [-3,0,2] [-5,-3,0] [-7,-5,-3]>")
    .scale("G5:major")
    .sound("gm_harmonica")
    .vib("8:0.05")
    .gain("<.3 .25 .2 .2 .2 .2 .2 .2>")
    .mask("<0@4 1@124>")    .color("brown")
    ._pianoroll()
,
  // Bass Flute
  n("<-4 -3 -2 [0@1.5 1@0.5]>")
    .room(.3)
    .scale("G3:major")
    .sound("sine")
    .gain(.6)
    .mask("<0@8 1@120>")
    .color("red")
    ._pianoroll(),
  // Piano
  n("<-4*8 -3*8 -2*8 [0*4 [0*2 1*2]]>")
    .scale("G2:major")
    .sound("piano")
    .clip(0.9)
    .gain(.2)
    .mask("<0@20 1@108>")
    ._pianoroll(),
  n("0@1.5 -3@1.5 0@1.5 -3@1.5 0 1 0@1.5 -1@1.5 0@1.5 -1@1.5 3 2 0@1.5 -3@1.5 -5@1.5 0@1.5 -4 -5 1@1.5 2@1.5 1@1.5 2@1.5 [1 2] [4 2]")
    .slow(4)
    .scale("G4:major")
    .sound("piano")
    .clip(1.5)
    .gain(.7)
    .mask("<0@20 1@108>")
    ._pianoroll(),
  // Drums
  s("[hr16_rim!3 - hr16_rim - lm8953_rim!2] <[hr16_rim -!3 hr16_rim -!3] [hr16_rim!2 - hr16_rim!3 - hr16_rim]>")
    .room(1.0)
    .gain(0.4)
    .mask("<0@16 1@112>")
    ._pianoroll(),
  s("<[lt - lt!4 -!2] [lt - lt!3 - lt -]>*2")
    .bank("yamaharx21")
    .room(0.8)
    .gain(0.15)
    .mask("<0@16 1@112>")
    ._pianoroll(),
  // Theremin
  stack("5@1.5 4:-1@6.5 3@1.5 2:-1@4 [2:-0.5 3:0.5] [2:-0.5 1:-0.5] 2:1@0.5 1:-1@1.5 0:-1@6.5 5@1.5 4:-2@2.5 7:1@2 8:3 11:2")
    .as("n:penv")
    .slow(4)
    .pattack(0.5)
    .vib("3.5:0.3")
    .scale("G4:major")
    .sound("sine")
    .delay(0.2)
    .dfb(0.35)
    .dt(60/128)
    .gain(0.6)
    .mask("<0@24 1@104>")
    ._pianoroll()
).room(0.8);

stack(
  // Hack: manual preloading (avoid JIT loading of samples)
  song.gain(0).fast(32).mask("<1 0@1000>"),
  
  // Play the actual song
  song
);

